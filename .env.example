# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Email Configuration (Gmail SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-specific-password
DJANGO_DEFAULT_FROM_EMAIL=Grievance Redressal Admin

# Note: Never commit the actual .env file to version control
# Copy this file to .env and fill in your actual values
# The .env file is already in .gitignore